# Project identity
ENV=jazzy-project-group-test1
COMPOSE_PROJECT_NAME=jazzy-project-group-test1

# Network
BASE_NET_RANGE=10.4.4
TTYD_PORT=9000
ROS_MASTER_URI_PORT=11311
DISPLAY=:1

# ZeroTier interfaces
VEHICLE_NETWORK_IFACE=ztqtitvw44
OPERATOR_NETWORK_IFACE=ztqtitvw44

###################################################################################
###--- docker-compose.yaml variables -------------------------------------------###
###################################################################################

DOCKER_TAG=latest
DOCKER_REGISTRY=gitlab.lrz.de:5005/teleoperiertes_fahren/tod

###--- Base Stage
DOCKER_UID=1000
DOCKER_USERNAME=tum
DOCKER_ROS_DISTRO=jazzy

###--- Builder Stage
VEHICLE_BUILD_ARGS="--packages-ignore tod_edgarautoware_interface tod_edgar_interface tod_dummy --cmake-args -DVEHICLE=ON -DOPERATOR=OFF -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF"
OPERATOR_BUILD_ARGS="--cmake-args -DVEHICLE=OFF -DOPERATOR=ON -DCMAKE_BUILD_TYPE=Release"

###--- ROS Settings
DOCKER_ROS_DOMAIN_ID=7
DOCKER_RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

###--- DDS config (zerotier: use ZeroTier interface for cross-machine DDS)
DOCKER_CYCLONEDDS_CONFIG=zerotier

###--- ROS Launch Arguments
MODE=only_sim
VEHICLE_ID=carla
TOD_INPUT_DEVICE_CONFIG=logitechg29.yaml
